@@ -0,0 +1,169 @@
+/**
+ * Inventory helpers — availability, production consumption, restock.
+ *
+ * Spec §6: services link to an InventoryItem via Service.materialStockItemId.
+ * Availability shown to customers = on-hand − material promised to paid
+ * orders waiting in IN_QUEUE. Consumption happens atomically at production
+ * start (IN_QUEUE → IN_PRODUCTION); refunds of produced orders restock.
+ */
+import { db } from '@/lib/db';
+
+export interface Availability {
+  status: 'IN_STOCK' | 'LOW' | 'OUT_OF_STOCK';
+  remaining: number;
+  etaDays?: number;
+}
+
+interface MaterialService {
+  id: string;
+  materialStockItemId: string | null;
+  materialQtyPerUnit: number;
+}
+
+/** Available-for-promise for a service × quantity (null when no stock link). */
+export async function getServiceAvailability(
+  service: MaterialService,
+  quantity: number
+): Promise<Availability | null> {
+  if (!service.materialStockItemId) return null;
+  const [item, pendingRows] = await Promise.all([
+    db.inventoryItem.findUnique({
+      where: { id: service.materialStockItemId },
+      select: { quantityInStock: true, reorderThreshold: true },
+    }),
+    db.order.findMany({
+      where: { serviceId: service.id, state: 'IN_QUEUE' },
+      select: { quantity: true },
+    }),
+  ]);
+  if (!item) return null;
+  const pending = pendingRows.reduce((sum, o) => sum + o.quantity * service.materialQtyPerUnit, 0);
+  const remaining = Math.max(0, Math.floor(item.quantityInStock - pending));
+  const status = remaining <= 0 ? 'OUT_OF_STOCK' : remaining <= item.reorderThreshold ? 'LOW' : 'IN_STOCK';
+  return {
+    status,
+    remaining,
+    etaDays: status === 'OUT_OF_STOCK' ? 3 : status === 'LOW' ? 2 : undefined,
+  };
+}
+
+/** Material needed (units of the stock item) for an order. */
+export async function materialNeededForOrder(order: {
+  serviceId: string;
+  quantity: number;
+}): Promise<{ itemId: string; itemName: string; needed: number } | null> {
+  const service = await db.service.findUnique({
+    where: { id: order.serviceId },
+    select: { materialStockItemId: true, materialQtyPerUnit: true, label: true },
+  });
+  if (!service?.materialStockItemId) return null;
+  const item = await db.inventoryItem.findUnique({
+    where: { id: service.materialStockItemId },
+    select: { name: true },
+  });
+  if (!item) return null;
+  return { itemId: service.materialStockItemId, itemName: item.name, needed: Math.ceil(order.quantity * service.materialQtyPerUnit) };
+}
+
+/**
+ * Atomically consume material for an order (production start).
+ * CAS-guarded: only succeeds while enough stock remains.
+ */
+export async function consumeMaterialForOrder(order: {
+  id: string;
+  orderNumber: string;
+  brand: string;
+  serviceId: string;
+  quantity: number;
+}): Promise<{ ok: true } | { ok: false; error: string }> {
+  const mat = await materialNeededForOrder(order);
+  if (!mat) return { ok: true }; // no stock link (customer-supplied / custom job)
+
+  const res = await db.inventoryItem.updateMany({
+    where: { id: mat.itemId, quantityInStock: { gte: mat.needed } },
+    data: { quantityInStock: { decrement: mat.needed } },
+  });
+  if (res.count !== 1) {
+    const item = await db.inventoryItem.findUnique({
+      where: { id: mat.itemId },
+      select: { quantityInStock: true },
+    });
+    const have = item?.quantityInStock ?? 0;
+    await flagBlockedProduction(order, mat.itemName, mat.needed, have);
+    return { ok: false, error: `Insufficient stock: ${mat.itemName} — need ${mat.needed}, have ${have}` };
+  }
+
+  await db.inventoryTransaction.create({
+    data: {
+      itemId: mat.itemId,
+      type: 'PRODUCTION_CONSUMPTION',
+      quantity: -mat.needed,
+      reason: `Order ${order.orderNumber} production start`,
+      orderId: order.id,
+    },
+  });
+  return { ok: true };
+}
+
+/** Restock material for a refunded order that already consumed it. */
+export async function restockMaterialForOrder(order: {
+  id: string;
+  orderNumber: string;
+  serviceId: string;
+  quantity: number;
+}): Promise<void> {
+  const mat = await materialNeededForOrder(order);
+  if (!mat) return;
+  await db.inventoryItem.update({
+    where: { id: mat.itemId },
+    data: { quantityInStock: { increment: mat.needed } },
+  });
+  await db.inventoryTransaction.create({
+    data: {
+      itemId: mat.itemId,
+      type: 'REFUND_RESTOCK',
+      quantity: mat.needed,
+      reason: `Refund of order ${order.orderNumber}`,
+      orderId: order.id,
+    },
+  });
+}
+
+/**
+ * Best-effort admin visibility when production can't start: append a note to
+ * the order and draft a purchase order so the shortage is actionable.
+ */
+async function flagBlockedProduction(
+  order: { id: string; orderNumber: string; brand: string },
+  itemName: string,
+  needed: number,
+  have: number
+): Promise<void> {
+  try {
+    await db.order.update({
+      where: { id: order.id },
+      data: {
+        adminNotes: `BLOCKED at production start: insufficient ${itemName} (need ${needed}, have ${have}). Restock or override.`,
+      },
+    });
+  } catch {
+    // non-fatal
+  }
+  try {
+    const supplier = await db.supplier.findFirst({ select: { id: true } });
+    if (supplier) {
+      await db.purchaseOrder.create({
+        data: {
+          poNumber: `PO-${Date.now()}`,
+          supplierId: supplier.id,
+          brand: (order.brand as 'SKYAL' | 'PABERIN') || 'PABERIN',
+          items: JSON.stringify([{ name: itemName, qty: Math.max(needed * 2, 5), unitCost: 0 }]),
+          totalAmount: 0,
+          status: 'PENDING',
+        },
+      });
+    }
+  } catch {
+    // non-fatal — draft PO is a convenience
+  }
+}
