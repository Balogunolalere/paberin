+++ b/src/lib/rule-lookup.ts	2026-08-02 05:07:36.385732452 +0100
@@ -0,0 +1,98 @@
+/**
+ * Rule lookup — resolve a bespoke job description to the closest catalog
+ * service (Tier 2 → Tier 1 promotion). Spec §5.1.
+ *
+ * This is a small, explicit rule table (NOT fuzzy matching): the AI maps by
+ * intent, and here we decide the fallback price rule for jobs that don't
+ * match a specific catalog line — e.g. "cut my jeans" → fabric_custom
+ * (₦10k/section, min ₦20k), "engrave wood" → engraving_wood.
+ */
+import { Brand } from '@prisma/client';
+import { db } from '@/lib/db';
+
+export interface CustomSpec {
+  description?: string;
+  material?: string;
+  dimensions?: string;
+  complexity?: string;
+}
+
+/** Service type suffix per rule key; SKYAL uses bare keys, PABERIN uses `paberin_` prefix. */
+function typeKey(brand: Brand, key: string): string {
+  return brand === Brand.PABERIN ? `paberin_${key}` : key;
+}
+
+interface Rule {
+  key: string;
+  patterns: RegExp[];
+  /** Explicit type override per brand (when the prefixed key doesn't exist). */
+  overrides?: Partial<Record<Brand, string>>;
+}
+
+const RULES: Rule[] = [
+  {
+    key: 'topper_custom',
+    patterns: [/cake ?topper/i, /\btopper\b/i, /name ?plate/i, /wedding ?sign/i],
+  },
+  {
+    key: 'engraving_phone',
+    patterns: [/phone ?back/i, /phone/i],
+  },
+  {
+    key: 'engraving_wood',
+    patterns: [/engrav/i, /wood ?engrav/i, /leather ?engrav/i, /jewelry/i, /necklace/i, /badge/i, /stirrer/i, /personaliz/i],
+  },
+  {
+    key: 'fabric_custom',
+    patterns: [
+      /fabric/i, /garment/i, /buba/i, /wrapper/i, /sleeve/i, /boubou/i, /aso-?ebi/i,
+      /ankara/i, /lace/i, /skirt/i, /gown/i, /blouse/i, /iro\b/i, /gele/i, /vintage/i,
+      /jeans/i, /denim/i, /trouser/i, /shirt/i, /dress/i, /material/i, /cloth/i,
+    ],
+  },
+  {
+    key: 'signage_acrylic',
+    // NOTE: bare /sign/i is deliberately NOT used — "design", "assign" etc.
+    // are not signage. Only explicit signage vocabulary matches.
+    patterns: [/signage/i, /sign ?board/i, /shop ?front/i, /lettering/i, /name ?plate/i],
+  },
+  {
+    key: 'acrylic_sticks',
+    patterns: [/\bsticks?\b/i, /\bstraws?\b/i, /stirrers?/i],
+  },
+  {
+    key: 'printed_tag',
+    patterns: [/\btag\b/i, /\blabel\b/i, /printed ?card/i, /\bcard\b/i, /invite/i],
+  },
+  {
+    key: 'sheet_cutting',
+    // NOTE: the bare verb "cut" is deliberately NOT a pattern — "cut my jeans"
+    // is fabric work, "re-cut a chandelier" is unknown. Sheet cutting is
+    // matched by MATERIAL/OBJECT keywords, not by the verb.
+    patterns: [/sheet/i, /\bacrylic\b/i, /\bwood\b/i, /4ft|8ft|4×4|8×4/i, /sign ?board/i, /name ?plate/i],
+    overrides: { [Brand.PABERIN]: 'paberin_sheet_cutting', [Brand.SKYAL]: 'sheet_cutting_inhouse' },
+  },
+];
+
+/**
+ * Resolve a custom job to the closest rule-based catalog service for a brand.
+ * Returns null when nothing sensible fits (→ provisional QUOTING order).
+ */
+export async function resolveCustomToService(
+  brand: Brand,
+  spec: CustomSpec
+): Promise<{ serviceType: string | null; reason: string }> {
+  const haystack = `${spec.description || ''} ${spec.material || ''}`.trim();
+  if (!haystack) return { serviceType: null, reason: 'no description' };
+
+  for (const rule of RULES) {
+    if (!rule.patterns.some((p) => p.test(haystack))) continue;
+    const type = rule.overrides?.[brand] || typeKey(brand, rule.key);
+    const exists = await db.service.findFirst({
+      where: { brand, type, isActive: true },
+      select: { id: true },
+    });
+    if (exists) return { serviceType: type, reason: `rule: ${rule.key}` };
+  }
+  return { serviceType: null, reason: 'no rule matched' };
+}
