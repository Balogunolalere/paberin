+/** GET /api/quotes?phone=… — List a customer's saved quote snapshots. */
+import { NextRequest, NextResponse } from 'next/server';
+import { db } from '@/lib/db';
+import { isValidPhone, phoneVariants } from '@/lib/phone';
+
+export const runtime = 'nodejs';
+
+export async function GET(req: NextRequest) {
+  const phone = req.nextUrl.searchParams.get('phone');
+  if (!phone || !isValidPhone(phone)) {
+    return NextResponse.json({ error: { code: 'BAD_REQUEST', message: 'Valid phone required (7–15 digits)' } }, { status: 400 });
+  }
+
+  const variants = phoneVariants(phone);
+  const quotes = await db.quote.findMany({
+    where: { customerPhone: { in: variants }, status: 'OPEN' },
+    orderBy: { createdAt: 'desc' },
+    take: 20,
+  });
+
+  return NextResponse.json({
+    data: quotes.map((q) => ({
+      id: q.id,
+      quoteNumber: q.quoteNumber,
+      totalAmount: q.totalAmount,
+      discount: q.discount,
+      deliveryFee: q.deliveryFee,
+      serviceType: q.serviceType,
+      status: q.status,
+      expiresAt: q.expiresAt,
+      createdAt: q.createdAt,
+      requestJson: q.requestJson,
+    })),
+  });
+}
