@@ -0,0 +1,94 @@
+/**
+ * resolveDiscounts — single source of truth for order discounts.
+ *
+ * Both POST /api/services/quote and POST /api/orders call this so a quote and
+ * the resulting order can never disagree on the discount.
+ *
+ * Rules (spec §4.2):
+ *  - First-time discount applies iff the customer claims to be new AND the
+ *    phone has no prior *paid* order (paymentConfirmedAt set), using the
+ *    per-brand setting `first_time_discount_naira`.
+ *  - Referral discount applies iff the code is active, matches the brand and
+ *    has capacity (usesCount < maxUses), using Referral.rewardAmount.
+ *  - The two never stack — the larger wins.
+ */
+import { Brand } from '@prisma/client';
+import { db } from '@/lib/db';
+import { phoneVariants } from '@/lib/phone';
+
+export type DiscountType = 'REFERRAL' | 'FIRST_TIME' | 'NONE';
+
+export interface DiscountResolution {
+  referralDiscountNaira: number;
+  firstTimeDiscountNaira: number;
+  discountType: DiscountType;
+  referralId: string | null;
+  /** True when the referral code actually produced a discount (drives usesCount). */
+  referralApplied: boolean;
+}
+
+/** Read a per-brand setting with a fallback. */
+export async function getSetting(brand: Brand, key: string, fallback = ''): Promise<string> {
+  try {
+    const row = await db.setting.findFirst({ where: { brand, key } });
+    return row?.value ?? fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+export async function resolveDiscounts(params: {
+  brand: Brand;
+  phone?: string | null;
+  referralCode?: string | null;
+  isFirstTimeCustomer?: boolean;
+}): Promise<DiscountResolution> {
+  // ── First-time discount ────────────────────────────────────────────────
+  let firstTimeDiscountNaira = 0;
+  if (params.isFirstTimeCustomer && params.phone) {
+    const settingVal = await getSetting(params.brand, 'first_time_discount_naira', '0');
+    firstTimeDiscountNaira = Number.parseInt(settingVal, 10) || 0;
+    if (firstTimeDiscountNaira > 0) {
+      // Only for customers with no prior paid order (phone variant-matched).
+      const variants = phoneVariants(params.phone);
+      const priorPaid = await db.order.findFirst({
+        where: { customerPhone: { in: variants }, paymentConfirmedAt: { not: null } },
+        select: { id: true },
+      });
+      if (priorPaid) firstTimeDiscountNaira = 0;
+    }
+  }
+
+  // ── Referral discount ──────────────────────────────────────────────────
+  let referralDiscountNaira = 0;
+  let referralId: string | null = null;
+  if (params.referralCode) {
+    const referral = await db.referral.findFirst({
+      where: { code: params.referralCode, brand: params.brand, isActive: true },
+      select: { id: true, rewardAmount: true, maxUses: true, usesCount: true },
+    });
+    if (referral && (referral.maxUses === null || referral.usesCount < referral.maxUses)) {
+      referralDiscountNaira = referral.rewardAmount;
+      referralId = referral.id;
+    }
+  }
+
+  // ── Never stack — the larger wins ──────────────────────────────────────
+  let discountType: DiscountType = 'NONE';
+  if (referralDiscountNaira > 0 && referralDiscountNaira >= firstTimeDiscountNaira) {
+    discountType = 'REFERRAL';
+    firstTimeDiscountNaira = 0;
+  } else if (firstTimeDiscountNaira > 0) {
+    discountType = 'FIRST_TIME';
+    referralDiscountNaira = 0;
+    referralId = null;
+  }
+
+  return {
+    referralDiscountNaira,
+    firstTimeDiscountNaira,
+    discountType,
+    referralId,
+    referralApplied: discountType === 'REFERRAL' && !!referralId,
+  };
+}
