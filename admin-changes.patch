+import { createOrderFromQuote } from '@/lib/order-state-machine';
+import { OrderState, SLA } from '@prisma/client';
+
+export const runtime = 'nodejs';
+
+export async function POST(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  try {
+    const { id } = await params;
+    const body = await req.json().catch(() => ({}));
+    const phone = (body.customerPhone || '').toString();
+    if (!isValidPhone(phone)) {
+      return NextResponse.json({ error: { code: 'BAD_REQUEST', message: 'Valid phone required (7–15 digits)' } }, { status: 400 });
+    }
+
+    const quote = await db.quote.findUnique({ where: { id } });
+    if (!quote) return NextResponse.json({ error: { code: 'NOT_FOUND', message: 'Quote not found' } }, { status: 404 });
+
+    // Ownership: the accepting phone must match the quote's phone.
+    const variants = phoneVariants(phone);
+    if (!variants.includes(quote.customerPhone)) {
+      return NextResponse.json({ error: { code: 'FORBIDDEN', message: 'This quote belongs to a different customer.' } }, { status: 403 });
+    }
+    if (quote.status !== 'OPEN') {
+      return NextResponse.json({ error: { code: 'QUOTE_NOT_OPEN', message: `Quote is ${quote.status}` } }, { status: 409 });
+    }
+    if (quote.expiresAt && new Date() > quote.expiresAt) {
+      await db.quote.update({ where: { id }, data: { status: 'EXPIRED' } }).catch(() => {});
+      return NextResponse.json({ error: { code: 'QUOTE_EXPIRED', message: 'This quote has expired — please request a fresh quote.' } }, { status: 410 });
+    }
+
+    // Reconstruct the request + resolve the service.
+    let request: any = {};
+    try { request = JSON.parse(quote.requestJson); } catch { /* keep {} */ }
+    const quantity = Math.max(1, Number(request.quantity) || 1);
+    const serviceType = quote.serviceType || request.serviceType;
+    const service = serviceType
+      ? await db.service.findFirst({ where: { brand: quote.brand, type: serviceType } })
+      : null;
+    if (!service) {
+      return NextResponse.json({ error: { code: 'SERVICE_NOT_FOUND', message: 'The quoted service is no longer available.' } }, { status: 409 });
+    }
+
+    const order = await createOrderFromQuote({
+      brand: quote.brand,
+      serviceId: service.id,
+      serviceType: service.type,
+      serviceLabel: service.label,
+      quantity,
+      sla: (request.sla === 'Express' && service.allowExpress) ? SLA.EXPRESS : SLA.STANDARD,
+      basePrice: 0, // snapshot pricing — stored breakdown fields are informational
+      expressSurcharge: 0,
+      addOnsTotal: 0,
+      discount: quote.discount,
+      discountType: 'NONE',
+      deliveryFee: quote.deliveryFee,
+      totalAmount: quote.totalAmount,
+      customerName: request.customerName || 'Customer',
+      customerPhone: quote.customerPhone,
+      customerEmail: request.customerEmail || '',
+      deliveryMethod: request.deliveryMethod || undefined,
+      deliveryAddress: request.deliveryAddress || undefined,
+      designFileUrl: request.designFileUrl,
+      customerNotes: request.customerNotes || undefined,
+      state: OrderState.PAYMENT_PENDING,
+    });
+
+    await db.quote.update({ where: { id }, data: { status: 'ACCEPTED', orderId: order.id } });
+
+    return NextResponse.json({ data: order }, { status: 201 });
+  } catch (e: any) {
+    return NextResponse.json({ error: { code: 'QUOTE_ACCEPT_ERROR', message: e.message } }, { status: 500 });
+  }
+}
